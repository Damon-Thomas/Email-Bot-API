# Environment variables for Mailer API

# Server Configuration
PORT=3000
NODE_ENV=development

# Brevo Email Configuration (HTTP API)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-email@yourdomain.com
BREVO_FROM_NAME=Your App Name

# Optional: Rate limiting (requests per minute per IP)
RATE_LIMIT_POINTS=5
RATE_LIMIT_DURATION=60

# Security Configuration
API_KEY=your-secure-api-key-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
ALLOWED_DOMAINS=yourdomain.com,localhost