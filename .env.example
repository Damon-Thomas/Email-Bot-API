# Environment variables for Mailer API

# Server Configuration
PORT=3000
NODE_ENV=development

# Gmail Configuration - Using App Password Authentication (recommended)
GMAIL_USER=your-email@gmail.com
GMAIL_FROM_NAME=Your App Name
GMAIL_APP_PASSWORD=your-app-password

# OAuth2 Configuration (optional - leave empty to use app password)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: Rate limiting (requests per minute per IP)
RATE_LIMIT_POINTS=5
RATE_LIMIT_DURATION=60

# Security Configuration
API_KEY=your-secure-api-key-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
ALLOWED_DOMAINS=yourdomain.com,localhost